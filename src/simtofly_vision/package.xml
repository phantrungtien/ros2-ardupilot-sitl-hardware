<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simtofly_vision</name>
  <version>1.0.0</version>
  <description>Vision node: person detection + ReID that publishes /follow/command and
    /follow/target for the trackinghuman controller in simtofly_mavros_sitl.
    Heavy ML deps (torch, ultralytics, opencv) are installed via pip, not rosdep.</description>
  <maintainer email="phantrungtien1034@gmail.com">phantrungtien</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware</url>
  <url type="repository">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware</url>
  <url type="bugtracker">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware/issues</url>

  <author email="phantrungtien1034@gmail.com">phantrungtien</author>

  <!-- Runtime dependencies (ROS). torch/ultralytics/opencv/torchreid are pip
       deps, NOT rosdep keys -> installed manually (see package README). -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
