<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simtofly_gates</name>
  <version>1.0.0</version>
  <description>Fly a course of racing rings on the onboard camera alone, N1-N7.
    N1 finds each orange ring and fits its plane in the depth cloud, N2 tracks
    them into a stable map, N3/N4 build an occupancy grid and plan through the
    next ring, N5 flies that path as a Mueller minimum-jerk trajectory, N6 owns
    the mission and judges every pass, N7 draws the live plan back onto the
    colour image.</description>
  <maintainer email="phantrungtien1034@gmail.com">phantrungtien</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware</url>
  <url type="repository">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware</url>
  <url type="bugtracker">https://github.com/phantrungtien/ros2-ardupilot-sitl-hardware/issues</url>

  <author email="phantrungtien1034@gmail.com">phantrungtien</author>

  <!-- numpy/scipy/opencv are pip deps, NOT rosdep keys. -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <!-- guided_base lives there and is shared with the non-gate missions
       (mission_circle, verify_frame), so it is a dependency rather than a copy:
       one arming path, one place to fix it. -->
  <depend>simtofly_mavros_sitl</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
